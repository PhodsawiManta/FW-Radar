# OpenAI / GPT Luna API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
GPT_MODEL=gpt-6-luna

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=-1003850293006

# Fastwork Scanner & Pagination Configuration
POLL_INTERVAL_SECONDS=120
FASTWORK_PAGE_SIZE=20
FASTWORK_MAX_PAGES=10
# กำหนดวันที่ต้องการดึงงาน: today (ค่าเริ่มต้น = วันนี้), yesterday, 3d (ย้อนหลัง 3 วัน),
# หรือระบุวันที่ เช่น 22/10/2026, 2026-10-22, หรือช่วงวันที่ 20/10/2026-22/10/2026
FASTWORK_TARGET_DATE=today
MIN_MATCH_SCORE=65

# Default Job Filter Criteria for GPT Luna
JOB_FILTER_CRITERIA=สนใจงานประเภท: เขียนโปรแกรม (Programming), พัฒนาเว็บไซต์ (Web Development, Frontend, Backend, Full-stack, WordPress), ทำแอปพลิเคชัน (Mobile App, iOS, Android, Flutter, React Native), ทำบอท (Bot, LINE OA, Telegram, Discord, Automation, Web Scraping), เชื่อมต่อระบบ API, AI / Machine Learning / LLM / ChatGPT, Database, แก้บั๊ก, หรือที่ปรึกษาทำแอป/ซอฟต์แวร์ ไม่สนใจงานประเภท: แม่บ้าน, ขับรถ, พิธีกร/VJ/MC ไลฟ์สด, ถ่ายภาพ, แต่งหน้า, หรือพนักงานขายทั่วไป
